{
  "manifest_version": 3,
  "name": "Screen Snap & Rectangle Editor",
  "version": "1.0.0",
  "description": "Capture screen viewport instantly, draw rectangles to highlight content, and copy directly to clipboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capture Screen & Annotate (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Take viewport screenshot and open editor"
    }
  }
}
